# Образец файла настроек.
# Скопируйте его в файл с именем .env и впишите свои значения.
# Сам .env в репозиторий не попадает — в нём хранятся пароли.

# --- Основное ---------------------------------------------------------------
# Длинную случайную строку можно получить командой:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=
# На сервере обязательно DEBUG=False
DEBUG=True

# --- База данных ------------------------------------------------------------
# Если эти строки закомментировать, проект запустится на SQLite —
# так удобно посмотреть сайт сразу после скачивания.
DB_NAME=getcourse
DB_USER=postgres
DB_PASSWORD=ваш-пароль
DB_HOST=127.0.0.1
DB_PORT=5432

# Путь к программам PostgreSQL. Нужен только на Windows, если psql не найден.
# PG_BIN=C:\Program Files\PostgreSQL\15\bin

# --- Адреса сайта -----------------------------------------------------------
# На сервере перечислите домены через запятую, например:
# ALLOWED_HOSTS=getcourse.kg,www.getcourse.kg
ALLOWED_HOSTS=

# --- Telegram-бот -----------------------------------------------------------
# Токен выдаёт @BotFather. Без токена сайт работает, просто без Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# --- Почта ------------------------------------------------------------------
# Если EMAIL_HOST_USER не заполнен, письма печатаются в терминал —
# это удобно при разработке и не требует интернета.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
